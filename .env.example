# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://afterkey:afterkey@localhost:5432/afterkey

# Clave para firmar los JWT (use un valor largo y aleatorio)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Clave Fernet para cifrar credenciales de activos (obligatoria en producción)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

JWT_EXPIRES_MINUTES=60

# Correo: "console" (solo log, ideal para desarrollo) o "smtp"
MAIL_BACKEND=console
MAIL_FROM=AfterKey <no-reply@afterkey.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
